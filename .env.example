# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
# For SQLite (default for MVP)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# For PostgreSQL (when you scale)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=pyinnyahub_db
# DATABASE_USER=your_db_user
# DATABASE_PASSWORD=your_db_password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Email Settings (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Pyinnya Hub LMS <your-email@gmail.com>

# For SendGrid (alternative when you scale)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# Site Settings
SITE_NAME=Pyinnya Hub LMS
SITE_URL=http://localhost:8000
SUPPORT_EMAIL=support@pyinnyahub.com

# File Upload Settings (MAX_UPLOAD_SIZE is in bytes, 10485760 = 10MB)
MAX_UPLOAD_SIZE=10485760
ALLOWED_RECEIPT_TYPES=image/jpeg,image/png,application/pdf
ALLOWED_COURSE_FILE_TYPES=video/mp4,application/pdf,image/jpeg,image/png

# Subscription Settings
MONTHLY_DAYS=30
YEARLY_DAYS=365
EXPIRY_REMINDER_DAYS=3

# Feature Flags (Admin can toggle)
ENABLE_REGISTRATION=True
ENABLE_INSTRUCTOR_APPLICATIONS=True
ENABLE_PAYMENT_UPLOADS=True

# Security (JWT lifetimes in minutes: 60=1hr, 1440=24hrs)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# APScheduler
SCHEDULER_AUTOSTART=True
